# Frontend environment variables
# Replace values as needed for your environment.

# Clerk Publishable Key (from Clerk Dashboard > API Keys)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: If you run backend locally at a different port, set the API base URL.
REACT_APP_API_BASE_URL=http://localhost:3001

# Optional: Socket URL (falls back to API base). Leave empty to default.
# REACT_APP_SOCKET_URL=http://localhost:3001

# Note:
# - Do not include secret keys in the frontend .env. Clerk Secret Key is server-side only.
# - In production, use your production publishable key to avoid Clerk dev key warnings.
